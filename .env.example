# ==============================================================================
# MedReport AI — Production Environment Variables
# ==============================================================================

# Application Environment (production / development / staging)
ENVIRONMENT=production

# Server Port & Binding
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or * for public APIs)
CORS_ORIGINS=*

# File Upload Limits
MAX_UPLOAD_SIZE_MB=15

# Security Settings
DEBUG=False
